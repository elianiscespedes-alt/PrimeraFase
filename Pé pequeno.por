programa {
  funcao inicio() {
    //entendimento de problema
    //calcular o valor de vale trocas, considerando preço e quantidade
    //infos e variaveis
    inteiro quantidade
    real valeTroca, preco 
    //entrada de dados
    escreva("preço de cada par de calçado: ")
    leia(quantidade)
    escreva("quantidade de pares trocados:")
    leia(preco)
    escreva("total de vale Trocas:")
    //procesamento
    valeTroca = quantidade * preco
    // saida
    escreva(valeTroca)
  }
}
